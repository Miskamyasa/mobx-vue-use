{
  "author": "Denis <MiskaMyasa> Zaitsev",
  "bugs": {
    "url": "https://github.com/Miskamyasa/mobx-vue-use/issues"
  },
  "dependencies": {
    "mobx": "7.1.0",
    "vue": "3.5.44"
  },
  "description": "Vue 3 Composition API utilities for MobX integration",
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Miskamyasa/mobx-vue-use",
  "keywords": [
    "mobx",
    "vue3",
    "vue",
    "composition-api",
    "composition",
    "utility"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "name": "mobx-vue-use",
  "packageManager": "pnpm@12.11.2",
  "peerDependencies": {
    "mobx": ">=6.0.0",
    "vue": ">=3.5.34"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Miskamyasa/mobx-vue-use.git"
  },
  "scripts": {
    "build": "tsup src/mobx-vue-use.ts --format esm,cjs --dts --external vue,mobx --sourcemap --clean",
    "prepare": "pnpm build",
    "test": "vitest"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.1.2"
}
