{
  "author": "Denis <MiskaMyasa> Zaitsev",
  "bugs": {
    "url": "https://github.com/Miskamyasa/mobx-vue-use/issues"
  },
  "dependencies": {
    "mobx": "6.15.0",
    "vue": "3.5.30"
  },
  "description": "Vue 3 Composition API utilities for MobX integration",
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Miskamyasa/mobx-vue-use",
  "keywords": [
    "mobx",
    "vue3",
    "vue",
    "composition-api",
    "composition",
    "utility"
  ],
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "name": "mobx-vue-use",
  "packageManager": "pnpm@10.32.1",
  "peerDependencies": {
    "mobx": ">=6.0.0",
    "vue": ">=3.5.34"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Miskamyasa/mobx-vue-use.git"
  },
  "scripts": {
    "build": "tsup src/mobx-vue-use.ts --format esm,cjs --dts --external vue,mobx --sourcemap --clean",
    "prepare": "pnpm build",
    "test": "vitest"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.10"
}
